VITE_SUPABASE_URL=your_supabase_project_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Seasonal Diwali campaign. Omit to use the date window.
# true/false overrides dates. Dates are IST inclusive.
VITE_DIWALI_CAMPAIGN_ENABLED=
VITE_DIWALI_CAMPAIGN_START=2026-10-01
VITE_DIWALI_CAMPAIGN_END=2026-11-20

# After credentials are real, run supabase/reviews.sql in the Supabase SQL editor
# so /review submissions persist as PENDING and /reviews shows APPROVED rows only.